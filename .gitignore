# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Security & Credentials (never commit secrets)
.token
.pin
.env
*.env.local

# Server logs & user shared uploads
logs/*
!logs/.gitkeep
shared/*
!shared/.gitkeep

# Runtime state & trash
.trash/
.shared_links.json
.cron_tasks.json
.alerts_config.json
.ddns_config.json
.telemetry_history.json
backups/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Virtual environments
venv/
.venv/
env/

# IDE configurations
.vscode/
.idea/
